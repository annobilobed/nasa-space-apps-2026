---
// The AIRXON signature: a telemetry trace. Variant "flatline" shows a live
// signal that simply stops: the moment contact was lost.
interface Props { variant?: 'live' | 'flatline'; label?: string; class?: string }
const { variant = 'live', label, class: cls = '' } = Astro.props;
const pts: string[] = [];
for (let x = 0; x <= 600; x += 6) {
  const amp = variant === 'flatline' && x > 380 ? 0 : 6 + 10 * Math.abs(Math.sin(x / 41));
  const y = 20 + Math.sin(x / 7.3) * amp * (x % 36 < 18 ? 1 : 0.35);
  pts.push(`${x},${y.toFixed(1)}`);
}
const live = variant === 'flatline' ? pts.slice(0, 64) : pts;
---
<div class={`signal ${cls}`} role="img" aria-label={label ?? 'Decorative signal trace'}>
  <svg viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true">
    <polyline class="trace" points={live.join(' ')} vector-effect="non-scaling-stroke" />
  </svg>
</div>
<style>
  .signal { width: 100%; height: 40px; color: var(--cyan); }
  .signal svg { width: 100%; height: 100%; overflow: visible; }
  .trace { fill: none; stroke: currentColor; stroke-width: 1.4; stroke-dasharray: 2400; stroke-dashoffset: 2400; animation: draw 3.2s var(--ease-out) forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .trace { stroke-dashoffset: 0; animation: none; } }
</style>
