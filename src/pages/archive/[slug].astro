---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import Status from '../../components/Status.astro';
import Sources from '../../components/Sources.astro';
import HardwareCard from '../../components/HardwareCard.astro';
import MiniMap from '../../components/MiniMap.astro';
import { hardware, bySlug, fmtDate, fmtCoord, WORLD_LABEL, CATEGORY_LABEL, STATUS_EXPLAIN, PRECISION_LABEL, type Hardware } from '../../data/hardware';
import { getMedia, KIND_LABEL } from '../../lib/media';

export function getStaticPaths() {
  return hardware.map((h) => ({ params: { slug: h.slug }, props: { h } }));
}
const { h } = Astro.props as { h: Hardware };
const hero = getMedia(h.images[0]);
const related = h.related.map(bySlug).filter(Boolean) as Hardware[];
const accent = h.world === 'mars' ? 'mars' : h.world === 'moon' ? 'moon' : 'deep';
const facts: [string, string][] = [
  ['Mission', h.mission], ['Agency', h.agency], ['Destination', WORLD_LABEL[h.world]], ['Type', CATEGORY_LABEL[h.category]],
  ['Launch', fmtDate(h.launch)],
  ...(h.arrival ? [['Arrival', fmtDate(h.arrival)] as [string, string]] : []),
  ...(h.lastContact ? [['Last contact', fmtDate(h.lastContact)] as [string, string]] : []),
  ...(h.missionEnd ? [['Mission ended', fmtDate(h.missionEnd)] as [string, string]] : []),
];
import DocPromo from '../../components/DocPromo.astro';
---
<Base title={h.short} description={h.summary} current="archive" image={`/media/${hero.slug}-${hero.widths[1] ?? hero.widths[0]}.webp`}>
  <article class={`profile acc-${accent}`}>
    <header class="p-hero">
      <div class="p-hero-img" aria-hidden="true"><Img slug={h.images[0]} eager sizes="100vw" decorative /></div>
      <div class="wrap p-hero-copy">
        <nav aria-label="Breadcrumb" class="crumbs"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/archive/">Archive</a><span aria-hidden="true">/</span><a href={`/archive/#${h.world}`}>{WORLD_LABEL[h.world]}</a><span aria-hidden="true">/</span><span>{h.short}</span></nav>
        <h1>{h.name}</h1>
        <p class="lede">{h.summary}</p>
        <div class="p-status"><Status status={h.status} /><span class="telemetry"><span><b>Launch</b>{fmtDate(h.launch)}</span>{h.location.lat !== undefined && <span><b>Location</b>{fmtCoord(h.location.lat, h.location.lon)} ({h.location.precision})</span>}</span></div>
      </div>
    </header>

    <div class="wrap p-grid">
      <div class="p-main">
        <section aria-labelledby="purpose-h" class="block">
          <h2 id="purpose-h">Why it was sent</h2>
          <p class="lede-s">{h.purpose}</p>
        </section>

        {h.instruments.length > 0 && (
          <section aria-labelledby="inst-h" class="block">
            <h2 id="inst-h">Instruments &amp; equipment</h2>
            <ul class="pill-list">{h.instruments.map((i) => <li>{i}</li>)}</ul>
          </section>
        )}

        <section aria-labelledby="ach-h" class="block two">
          <div><h2 id="ach-h">Achievements</h2><ul class="ticks">{h.achievements.map((a) => <li>{a}</li>)}</ul></div>
          <div><h2>Discoveries</h2><ul class="ticks">{h.discoveries.map((a) => <li>{a}</li>)}</ul></div>
        </section>

        <section aria-labelledby="tl-h" class="block">
          <h2 id="tl-h">Mission timeline</h2>
          <ol class="vtl">{h.timeline.map((m) => <li><span class="mono">{fmtDate(m.date)}</span><span><strong>{m.label}</strong>{m.detail && <small>{m.detail}</small>}</span></li>)}</ol>
        </section>

        <section aria-labelledby="status-h" class="block status-block">
          <h2 id="status-h">Final known status</h2>
          <Status status={h.status} />
          <p>{h.statusNote}</p>
          <p class="muted small">What this label means: {STATUS_EXPLAIN[h.status]}</p>
        </section>

        <section aria-labelledby="loc-h" class="block">
          <h2 id="loc-h">Where it is now</h2>
          <p><strong>{h.location.label}</strong></p>
          <p class="muted small"><span class={`prec prec-${h.location.precision}`}>{PRECISION_LABEL[h.location.precision]}</span>{h.location.note && <>. {h.location.note}</>}</p>
          {h.location.source && <p class="muted small">Coordinate source: <a href={h.location.source.url} rel="noopener">{h.location.source.title}</a></p>}
          <MiniMap h={h} />
          {h.world !== 'deep-space' && <a class="btn btn-secondary" href={`/where/#${h.slug}`}>Open in the location explorer</a>}
        </section>

        <section aria-labelledby="sig-h" class="block">
          <h2 id="sig-h">Why it still matters</h2>
          <p class="lede-s">{h.significance}</p>
          {h.story && <a class="btn btn-primary" href={h.story}>Read the full mission story</a>}
        </section>

        <section aria-labelledby="gal-h" class="block">
          <h2 id="gal-h">Gallery</h2>
          <ul class="gallery" data-gallery>
            {h.images.map((slug, i) => {
              const m = getMedia(slug);
              return (
                <li>
                  <button type="button" class="g-btn" data-g-open={i} aria-label={`Enlarge image: ${m.title}`}>
                    <Img slug={slug} sizes="(min-width: 900px) 22vw, 45vw" />
                  </button>
                  <p class="placard"><span class="cap">{KIND_LABEL[m.kind] && <span class="kind-tag">{KIND_LABEL[m.kind]}</span>} {m.title}</span><span>{m.credit} · <a href={m.source} rel="noopener">{m.nasaId ?? 'source'}</a></span></p>
                </li>
              );
            })}
          </ul>
        </section>
      </div>

      <aside class="p-side" aria-label="Quick facts">
        <div class="side-card">
          <h2 class="side-h">Quick facts</h2>
          <dl class="facts">{facts.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
        </div>
        {h.slug === 'opportunity' && <DocPromo />}
      </aside>
    </div>

    {related.length > 0 && (
      <section class="wrap section--tight" aria-labelledby="rel-h">
        <h2 id="rel-h" class="rel-h">Related machines</h2>
        <ul class="rel">{related.map((r) => <li><HardwareCard h={r} /></li>)}</ul>
      </section>
    )}
    <section class="wrap section--tight"><Sources sources={h.sources} /></section>
  </article>

  <dialog class="lightbox" data-lightbox aria-label="Image viewer">
    <div class="lb-inner">
      <img alt="" data-lb-img />
      <p class="placard" data-lb-cap></p>
      <div class="lb-ctl">
        <button type="button" class="btn btn-secondary btn-sm" data-lb-prev>Previous</button>
        <button type="button" class="btn btn-secondary btn-sm" data-lb-next>Next</button>
        <button type="button" class="btn btn-primary btn-sm" data-lb-close>Close</button>
      </div>
    </div>
  </dialog>
</Base>

<script>
  import { initGallery } from '../../scripts/gallery';
  initGallery();
</script>

<style>
  .p-hero { position: relative; min-height: 78svh; display: grid; align-items: end; overflow: hidden; isolation: isolate; }
  .p-hero-img { position: absolute; inset: 0; z-index: -1; }
  .p-hero-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .p-hero-img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, var(--navy) 5%, rgb(8 13 28 / 0.6) 50%, rgb(8 13 28 / 0.3)); }
  .p-hero-copy { padding-block: calc(var(--nav-h) + 48px) 44px; display: grid; gap: 18px; }
  .p-hero h1 { max-width: 18ch; font-size: var(--step-5); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 10px; font-size: 0.9rem; color: var(--muted); }
  .crumbs a { color: var(--muted); }
  .p-status { display: flex; flex-wrap: wrap; gap: 10px 26px; align-items: center; }
  .p-status :global(.status) { font-size: 1rem; }
  .p-grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: var(--s-8); padding-block: var(--s-8); }
  .p-main { display: grid; gap: var(--s-8); }
  .block { display: grid; gap: 14px; }
  .block h2 { font-size: var(--step-3); }
  .lede-s { font-size: var(--step-1); line-height: 1.45; max-width: 46ch; }
  .small { font-size: 0.9rem; }
  .two { grid-template-columns: 1fr 1fr; gap: var(--s-6); }
  .two > div { display: grid; gap: 14px; align-content: start; }
  @media (max-width: 760px) { .two { grid-template-columns: 1fr; } }
  .pill-list { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pill-list li { border: 1px solid var(--border); border-radius: 999px; padding: 6px 14px; font-size: 0.9rem; color: var(--muted); }
  .ticks { list-style: none; padding: 0; display: grid; gap: 12px; }
  .ticks li { position: relative; padding-left: 24px; color: var(--muted); }
  .ticks li::before { content: ''; position: absolute; left: 2px; top: 0.6em; width: 6px; height: 6px; border-radius: 50%; background: var(--cyan); }
  .acc-mars .ticks li::before { background: var(--copper); }
  .vtl { list-style: none; padding: 0; border-left: 1px solid var(--border-strong); display: grid; gap: 18px; }
  .vtl li { display: grid; grid-template-columns: 150px 1fr; gap: 16px; padding-left: 20px; position: relative; }
  .vtl li::before { content: ''; position: absolute; left: -5px; top: 7px; width: 9px; height: 9px; border-radius: 50%; background: var(--navy); border: 2px solid var(--cyan); }
  .vtl .mono { font-size: 0.8rem; color: var(--cyan); padding-top: 2px; }
  .vtl small { display: block; color: var(--faint); font-size: 0.85rem; }
  @media (max-width: 560px) { .vtl li { grid-template-columns: 1fr; gap: 2px; } }
  .status-block { padding: 24px; border: 1px solid var(--border); border-radius: var(--r-2); background: var(--surface); }
  .status-block :global(.status) { font-size: 1.05rem; }
  .prec { font-weight: 700; color: var(--fg); }
  .prec-approximate { color: var(--warning); }
  .gallery { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; }
  .g-btn { display: block; width: 100%; padding: 0; border: 1px solid var(--border); border-radius: var(--r-1); overflow: hidden; background: var(--surface); cursor: zoom-in; aspect-ratio: 4 / 3; }
  .g-btn :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--t-slow) var(--ease-out); }
  .g-btn:hover { border-color: var(--star); }
  .p-side { position: relative; }
  .side-card { position: sticky; top: 90px; padding: 22px; border: 1px solid var(--border); border-radius: var(--r-2); background: var(--surface); display: grid; gap: 16px; }
  .side-h { font-size: var(--step-2); }
  .side-card .facts { grid-template-columns: 1fr; gap: 2px; }
  .side-card .facts dd { margin-bottom: 10px; }
  @media (max-width: 980px) { .p-grid { grid-template-columns: 1fr; } .p-side { order: -1; } .side-card { position: static; } .side-card .facts { grid-template-columns: max-content 1fr; gap: 8px 18px; } .side-card .facts dd { margin: 0; } }
  .rel-h { font-size: var(--step-3); margin-bottom: var(--s-5); }
  .rel { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 20px; }
  .rel > li { display: flex; max-width: none; } .rel > li > :global(*) { width: 100%; }
  .lightbox { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; }
  .lightbox::backdrop { background: rgb(8 13 28 / 0.94); }
  .lb-inner { height: 100%; display: grid; grid-template-rows: minmax(0, 1fr) auto auto; gap: 12px; padding: 24px var(--gutter); }
  .lb-inner img { max-width: 100%; max-height: 100%; margin: auto; object-fit: contain; }
  .lb-ctl { display: flex; gap: 10px; justify-content: center; }
</style>
