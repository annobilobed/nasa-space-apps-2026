{
  "name": "airxon",
  "version": "1.0.0",
  "description": "AIRXON: Echoes Beyond Earth, an interactive museum of NASA hardware left on the Moon, Mars and in deep space (NASA Space Apps 2026). Code written with AI assistance (Claude); see AI-DISCLOSURE.md.",
  "scripts": {
    "dev": "astro dev",
    "media": "node scripts/build-media.mjs",
    "build": "astro build",
    "build:portable": "PORTABLE=1 astro build && node scripts/portable.mjs",
    "preview": "astro preview",
    "test": "playwright test --trace off"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "astro": "^7.4.12",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "sharp": "^0.35.5"
  },
  "type": "module",
  "private": true,
  "ai": {
    "disclosure": "AI-DISCLOSURE.md",
    "tools": [
      "Claude (Anthropic) via Claude Code: code and text",
